{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlaySpace",
  "version": "2.1.0",
  "identifier": "io.playspace.next.local",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlaySpace 2.0",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#17181c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/playspace.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCOTI2QTlFRThERDJEM0EKUldRNkxkM29ubXFTeXd3K3A5ODNNSk8zZ2pSMUIyZUFPTHduRnRSV1VFRHNqSUtKRzVNUE9aejEK",
      "endpoints": [
        "https://github.com/d3a0g/playspace-releases/releases/latest/download/latest-v2.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  }
}
